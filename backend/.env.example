# ===== 应用配置 =====
APP_NAME=牛人Agent
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change_this_to_a_random_secret_key_please_123456

# ===== 数据库配置（MySQL） =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=job_auto

# ===== 也可以用SQLite快速调试 =====
# DB_URL=sqlite:///./job_auto.db

# ===== 上传配置 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# ===== Playwright 浏览器配置 =====
# 搜索/投递默认无头运行；登录扫码固定打开有头浏览器。
# 若需观察浏览器操作过程或手动完成Boss安全验证，可设为false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SLOW_MO=100

# ===== Boss直聘防封配置（保守策略） =====
# 每次投递的最小/最大间隔（秒），会在区间内随机
BOSS_APPLY_DELAY_MIN=15
BOSS_APPLY_DELAY_MAX=30
# 每日投递上限（Boss直聘普通用户每天约100次打招呼机会）
BOSS_DAILY_LIMIT=80
# 跳过HR多少天未活跃的岗位（boss_push的经验）
BOSS_SKIP_INACTIVE_DAYS=7

# ===== Cookie保存路径 =====
COOKIE_SAVE_DIR=./cookies
