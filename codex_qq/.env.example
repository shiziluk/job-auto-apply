# ===== QQ 开放平台机器人凭据 =====
# 在 https://q.qq.com 创建「机器人」应用（渠道选 单聊/C2C）并审核通过后获取
QQ_BOT_APP_ID=
QQ_BOT_APP_SECRET=
# true=沙箱网关调试（wss://sandbox.api.sgroup.qq.com），正式上线设 false
QQ_BOT_SANDBOX=false

# ===== 允许通过 QQ 与 Codex 对话的用户（openid，逗号分隔） =====
# 获取方式：在 QQ 里先给机器人发一条消息，再从桥接日志中找到 author.id 填入
# 留空 = 拒绝所有 QQ 消息（安全保护，务必配置）
QQ_ALLOW_UIDS=

# ===== Codex CLI =====
# 默认自动查找 npm 全局安装的 codex；也可以写完整路径
# CODEX_BIN=codex
# Codex 的工作目录（在此目录执行命令/读写文件，建议指向你的项目根）
# CODEX_WORKDIR=D:\workspace\自动投简历工具
# 单条消息处理超时（秒，0=不超时；默认 900=15 分钟）
# CODEX_TIMEOUT=900
# 长任务提示：处理超过 30 秒仍无回复时发的轻提示文案（想改人设口吻就改这里）
QQ_SLOW_HINT=……还在弄。小叶你先忙别的去，弄好我叫你。




